# ==========================================
# SISTEMA DE GESTÃO PATRIMONIAL - TRYNOVA
# ==========================================

# Banco de Dados PostgreSQL (Neon / RDS / Local)
DATABASE_URL=postgresql://usuario:senha@host:5432/banco?sslmode=require
PORT=3001

# ==========================================
# CONFIGURAÇÃO DE E-MAIL (SMTP) PARA RECUPERAÇÃO DE SENHA
# ==========================================
# Exemplo 1: Gmail (Requer gerar "Senha de App" na Conta Google)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=seu.email@gmail.com
# SMTP_PASS=sua_senha_de_app_de_16_digitos
# SMTP_FROM="Trynova Patrimônio" <seu.email@gmail.com>

# Exemplo 2: Microsoft 365 / Outlook
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=patrimonio@trynova.com.br
# SMTP_PASS=sua_senha_aqui
# SMTP_FROM="Trynova Patrimônio" <patrimonio@trynova.com.br>

# Exemplo 3: Servidor Próprio / Hostinger / cPanel / Titan
# SMTP_HOST=smtp.titan.email
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=suporte@trynova.com.br
# SMTP_PASS=sua_senha_aqui
# SMTP_FROM="Trynova Patrimônio" <suporte@trynova.com.br>

# ==========================================
# AUTENTICAÇÃO MICROSOFT ENTRA ID (AZURE AD SSO)
# ==========================================
# Obtenha estes valores em https://entra.microsoft.com/ -> App registrations
VITE_ENTRA_CLIENT_ID=seu_client_id_aqui
VITE_ENTRA_TENANT_ID=seu_tenant_id_aqui


